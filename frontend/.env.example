# ==============================================================================
# NOCTURNA SEXSHOP — Configuración de Entorno (Frontend)
# ==============================================================================

# MODO DEMO (para desplegar en Vercel sin backend ni base de datos online)
# Si VITE_DEMO_MODE=true, todas las llamadas a la API se resuelven en el
# navegador usando src/api/demo/demo-data.json y persistencia en localStorage
# (clave "nocturna-demo-state"). Si no está definida o es false, la aplicación
# se conecta normalmente al backend real (Express + Prisma).
VITE_DEMO_MODE=true

# Número de WhatsApp utilizado para generar el mensaje de checkout en modo demo
# (valor por defecto: 5493517572841)
VITE_DEMO_WHATSAPP=5493517572841

# URL de la API del backend real (solo se usa cuando VITE_DEMO_MODE no está activa)
# VITE_API_URL=http://localhost:3001/api

# Píxel de Meta en el navegador (en modo demo se desactiva automáticamente)
# VITE_META_PIXEL_ID=[META_PIXEL_ID]
