# Base de datos PostgreSQL
DATABASE_URL="postgresql://[DB_USER]:[DB_PASSWORD]@localhost:5432/nocturna_sexshop?schema=public"

# JWT (Obligatorios en producción)
JWT_ACCESS_SECRET="[GENERAR_SECRETO_JWT_ACCESS_SEGURO]"
JWT_REFRESH_SECRET="[GENERAR_SECRETO_JWT_REFRESH_SEGURO]"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# WhatsApp — Número de Nocturna SexShop (con código de país, sin + ni espacios)
WHATSAPP_PHONE="5493517572841"

# Server
PORT=3001
CORS_ORIGIN="http://localhost:5173"

# Admin seed (usuario administrador inicial)
ADMIN_EMAIL="[EMAIL_ADMIN]"
ADMIN_PASSWORD="[PASSWORD_ADMIN_SEGURO]"

# Cloudinary (Subida de imágenes)
CLOUDINARY_CLOUD_NAME="[CLOUDINARY_CLOUD_NAME]"
CLOUDINARY_API_KEY="[CLOUDINARY_API_KEY]"
CLOUDINARY_API_SECRET="[CLOUDINARY_API_SECRET]"

# Meta Pixel & API de Conversiones (Opcional — si falta, no se ejecuta)
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
VITE_META_PIXEL_ID=""
